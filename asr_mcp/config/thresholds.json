{
  "diarization": {
    "default_threshold": 0.35,
    "max_clusters": 15,
    "distance_threshold": 0.55,
    "merge_threshold": 0.35,
    "forced_k_linkage": "complete",
    "close_match_threshold": 0.17,
    "min_segment_duration": 0.5
  },
  "matching": {
    "accept_threshold": 0.35,
    "clear_winner_gap": 0.02,
    "embed_only_threshold": 0.16,
    "confidence_threshold": 0.3,
    "embed_only_accept_threshold": 0.22
  },
  "weights": {
    "embedding": 0.9,
    "pitch": 0.1
  },
  "normalization": {
    "pitch_hz_per_unit": 50,
    "confidence_max_distance": 0.5
  },
  "overlap": {
    "proximity_ratio": 0.08,
    "min_distance": 0.4,
    "min_duration_sec": 0.5,
    "max_speaker_gap": 1.5,
    "max_clarity": 0.08
  },
  "vad": {
    "default_threshold": 0.5,
    "min_speech_duration_ms": 250,
    "chunk_duration": 30,
    "overlap": 5
  },
  "boundary_refine": {
    "enabled": true,
    "min_gap_sec": 0.01,
    "min_section_sec": 0.3,
    "dip_ratio": 0.35,
    "min_dip_sec": 0.12
  },
  "second_pass": {
    "enabled": true,
    "known_speaker_margin_bias": 0.05,
    "accept_threshold": 0.38,
    "unknown_merge_threshold": 0.25,
    "min_speaker_duration_sec": 3.0,
    "min_identity_confidence": 0.5
  },
  "uncertainty": {
    "enabled": true,
    "min_speaker_confidence": 0.35,
    "min_match_margin": 0.02,
    "min_attribution_dur_sec": 0.5,
    "max_boundary_cross_sec": 0.3,
    "max_boundary_cross_ratio": 0.34,
    "max_boundary_cross_span_sec": 3.0,
    "turn_merge_gap_sec": 1.0,
    "result_merge_gap_sec": 1.0,
    "retain_uncertain_text": true,
    "auto_collect_requires_confidence": true,
    "suppress_ghost_speakers": true,
    "suppress_minority_speakers": true,
    "ghost_max_share": 0.25
  },
  "streaming": {
    "frame_ms": 32.0,
    "noise_floor_ratio": 3.0,
    "noise_floor_min": 0.004,
    "noise_floor_max": 0.05,
    "start_threshold_ratio": 2.5,
    "end_threshold_ratio": 1.6,
    "start_confirm_frames": 2,
    "end_confirm_frames": 3,
    "hangover_ms": 320,
    "pre_roll_ms": 160,
    "post_roll_ms": 200,
    "min_voiced_ms": 120,
    "max_turn_sec": 30.0,
    "queue_size": 8,
    "drop_on_overflow": true
  },
  "debug": false,
  "live_attribution": {
    "_comment": "Live (WebSocket) turn attribution. Live turns are 1-3s, so the bar is higher than the offline path; a mic turn is labelled from its input device and never embedding-matched against its own user's voiceprint.",
    "min_match_confidence": 0.6,
    "min_match_margin": 0.05,
    "min_turn_sec": 0.5,
    "max_turn_sec": 30.0,
    "match_voiceprints": true
  }
}
