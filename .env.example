# Environment Variables for asr-mcp

# Authentication
# HTPASSWD_PATH: the operator's own accounts. Read-only to this app.
HTPASSWD_PATH=/app/htpasswd
# API_KEYS: static keys. A matching X-API-Key runs as user_<sha256(key)[:16]>.
# Empty means open mode (an unauthenticated caller is `default`) — but only
# while registration is off; see below.
API_KEYS=
SESSION_SECRET=change_me_to_a_long_random_string

# Self-service registration. OFF by default: an endpoint that creates accounts
# is something an operator turns on, not something a deployment inherits by
# upgrading. Each method is additionally offered only when it is CONFIGURED —
# email needs a mail server, google needs a client id AND secret — so a
# half-configured deployment shows a working button or no card at all.
TRANSCRIBE_REGISTRATION_ENABLED=false

# Google sign-in (OAuth 2.0 authorization-code flow).
# The redirect URI registered with Google must be, verbatim:
#   {TRANSCRIBE_EXTERNAL_URL}/api/auth/google/callback
# Both halves are required: the secret is what makes the code exchange a
# confidential-client exchange, and a half-configured deployment can start a
# login and cannot finish it.
TRANSCRIBE_GOOGLE_CLIENT_ID=
TRANSCRIBE_GOOGLE_CLIENT_SECRET=
# Absolute base URL this deployment is served from (e.g. https://host/asr-mcp).
# Leave empty to derive it from the incoming request, which is correct until a
# reverse proxy rewrites the Host header.
#
# TRANSCRIBE_PREFIX may be INCLUDED here or left off — both spellings work and
# produce the same links, because the prefix is appended only when the base does
# not already end with it. So https://host and https://host/asr-mcp are both
# fine. Set it to the URL a user actually pastes into a browser, which is the
# one you can verify by clicking it.
TRANSCRIBE_EXTERNAL_URL=

# Confirmation mail. Only host and from are load-bearing: a relay on a trusted
# network may take no credentials, and a deployment with no host can send
# nothing, which is why those two are what smtp_configured() checks.
TRANSCRIBE_SMTP_HOST=
TRANSCRIBE_SMTP_PORT=587
TRANSCRIBE_SMTP_USER=
TRANSCRIBE_SMTP_PASSWORD=
TRANSCRIBE_SMTP_FROM=
TRANSCRIBE_SMTP_STARTTLS=true
TRANSCRIBE_SMTP_TIMEOUT=20

# The one account allowed to reach /api/admin/*. EMPTY MEANS NOBODY: the admin
# routes answer 403 and name this variable rather than falling back to
# "anyone who is logged in".
TRANSCRIBE_ADMIN_USER=

# GPU / CUDA
TRANSCRIBE_CUDA_DEVICE=cuda:0
TRANSCRIBE_TORCH_DTYPE=float16
TRANSCRIBE_GPU_MEMORY_LIMIT_GB=4.0

# Model Repos (HuggingFace)
TRANSCRIBE_MODEL_REPO=onnx-community/cohere-transcribe-03-2026-ONNX
TRANSCRIBE_EMBEDDING_MODEL_REPO=Wespeaker/wespeaker-ecapa-tdnn512-LM
TRANSCRIBE_VAD_MODEL_REPO=onnx-community/silero-vad

# ASR backend selection: cohere | qwen3-asr | whisper
TRANSCRIBE_ASR_MODEL=cohere

# Qwen3-ASR backend options (used when TRANSCRIBE_ASR_MODEL=qwen3-asr)
TRANSCRIBE_QWEN_MODEL_NAME=Qwen/Qwen3-ASR-1.7B
TRANSCRIBE_QWEN_MODEL_DIR=/app/models/qwen3-asr
TRANSCRIBE_QWEN_FORCED_ALIGNER_NAME=Qwen/Qwen3-ForcedAligner-0.6B
TRANSCRIBE_QWEN_FORCED_ALIGNER_DIR=/app/models/qwen3-forced-aligner
TRANSCRIBE_QWEN_TORCH_DTYPE=float16
TRANSCRIBE_QWEN_MAX_NEW_TOKENS=256
TRANSCRIBE_QWEN_MAX_INFERENCE_BATCH_SIZE=8
TRANSCRIBE_QWEN_QUANTIZE_4BIT=true
TRANSCRIBE_QWEN_ALIGNER_QUANTIZE_4BIT=true

# Whisper backend options (used when TRANSCRIBE_ASR_MODEL=whisper)
# Quantized via CTranslate2: auto = int8_float16 on CUDA, int8 on CPU
TRANSCRIBE_WHISPER_MODEL=large-v3-turbo
TRANSCRIBE_WHISPER_MODEL_DIR=/app/models/faster-whisper
TRANSCRIBE_WHISPER_COMPUTE_TYPE=auto
TRANSCRIBE_WHISPER_BEAM_SIZE=5
TRANSCRIBE_WHISPER_VAD_FILTER=true

# Server
TRANSCRIBE_HOST=0.0.0.0
TRANSCRIBE_PORT=8080
TRANSCRIBE_WORKERS=1
TRANSCRIBE_REQUEST_TIMEOUT=120

# Paths
TRANSCRIBE_DATA_DIR=/app/data
TRANSCRIBE_LOG_DIR=/app/logs
TRANSCRIBE_MODEL_CACHE_DIR=/app/models
TRANSCRIBE_VOICES_DIR=/app/voices
TRANSCRIBE_DB_PATH=/app/data/asr_mcp.db

# Diarization defaults
# NOTE: the clustering threshold is NOT an env var — it lives in
# asr_mcp/config/thresholds.json (diarization.distance_threshold /
# merge_threshold / forced_k_linkage). This setting is declared but unused.
TRANSCRIBE_DIARIZATION_THRESHOLD=0.35
TRANSCRIBE_VAD_THRESHOLD=0.5
TRANSCRIBE_VAD_MIN_SPEECH_DURATION_MS=250

# CORS
TRANSCRIBE_ENABLE_CORS=true
TRANSCRIBE_CORS_ORIGINS=["*"]

# Rate limiting
TRANSCRIBE_ENABLE_RATE_LIMIT=true
TRANSCRIBE_RATE_LIMIT=60/minute

# HuggingFace Token (optional, for gated models)
TRANSCRIBE_HF_TOKEN=

# Model idle timeout (0 = never unload)
TRANSCRIBE_MODEL_TTL_MINUTES=5

# Logging
TRANSCRIBE_LOG_LEVEL=INFO