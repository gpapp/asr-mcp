# Environment Variables for asr-mcp

# Authentication
HTPASSWD_PATH=/app/htpasswd
API_KEYS=

# Session
SESSION_SECRET=change_me_to_a_long_random_string

# GPU / CUDA
TRANSCRIBE_CUDA_DEVICE=cuda:0
TRANSCRIBE_TORCH_DTYPE=float16
TRANSCRIBE_GPU_MEMORY_LIMIT_GB=4.0

# Model Repos (HuggingFace)
TRANSCRIBE_MODEL_REPO=onnx-community/cohere-transcribe-03-2026-ONNX
TRANSCRIBE_EMBEDDING_MODEL_REPO=Wespeaker/wespeaker-ecapa-tdnn512-LM
TRANSCRIBE_VAD_MODEL_REPO=onnx-community/silero-vad

# Server
TRANSCRIBE_HOST=0.0.0.0
TRANSCRIBE_PORT=8080
TRANSCRIBE_WORKERS=1
TRANSCRIBE_REQUEST_TIMEOUT=120

# Paths
TRANSCRIBE_DATA_DIR=/app/data
TRANSCRIBE_LOG_DIR=/app/logs
TRANSCRIBE_MODEL_CACHE_DIR=/app/models
TRANSCRIBE_DB_PATH=/app/data/asr_mcp.db

# Diarization defaults
TRANSCRIBE_DIARIZATION_THRESHOLD=0.35
TRANSCRIBE_VAD_THRESHOLD=0.5
TRANSCRIBE_VAD_MIN_SPEECH_DURATION_MS=250

# CORS
TRANSCRIBE_ENABLE_CORS=true
TRANSCRIBE_CORS_ORIGINS=["*"]

# Rate limiting
TRANSCRIBE_ENABLE_RATE_LIMIT=true
TRANSCRIBE_RATE_LIMIT=60/minute

# HuggingFace Token (optional, for gated models)
TRANSCRIBE_HF_TOKEN=
